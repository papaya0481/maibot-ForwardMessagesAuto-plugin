{
  "manifest_version": 2,
  "id": "papaya0481.forward-messages-auto",
  "version": "0.1.11",
  "name": "麦麦自主跨群转发插件",
  "description": "由源群 Planner 判断是否分享合并转发消息，并按 QQ 群白名单顺序转发和触发目标群 Planner。",
  "author": {
    "name": "papaya0481",
    "url": "https://github.com/papaya0481"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/papaya0481/MaiBot_ForwardMessagesAuto_Plugin",
    "homepage": "https://github.com/papaya0481/MaiBot_ForwardMessagesAuto_Plugin",
    "documentation": "https://github.com/papaya0481/MaiBot_ForwardMessagesAuto_Plugin#readme",
    "issues": "https://github.com/papaya0481/MaiBot_ForwardMessagesAuto_Plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.1.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "share-2"
    }
  },
  "capabilities": [
    "send.forward",
    "message.get_by_id",
    "chat.get_stream_by_group_id",
    "chat.open_session",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
